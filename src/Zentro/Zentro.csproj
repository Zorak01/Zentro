<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets/Zentro.ico</ApplicationIcon>
    <Product>Zentro</Product>
    <Description>Tasks and notes for Windows.</Description>
    <Version>1.0.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Zentro.png" />
    <Resource Include="Assets/Zentro.ico" />
  </ItemGroup>
</Project>
