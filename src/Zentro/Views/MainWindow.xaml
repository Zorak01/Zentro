<Window x:Class="Zentro.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Zentro.Views"
        Style="{StaticResource {x:Type Window}}" Title="Zentro" Icon="/Zentro;component/Assets/Zentro.ico" Width="1320" Height="840" MinWidth="1060" MinHeight="680"
        WindowStyle="None" WindowStartupLocation="CenterScreen">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate x:Key="Card">
      <Border BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10" Cursor="Hand" Focusable="True"
              AutomationProperties.Name="{Binding Title}" ToolTip="Click or press Enter to edit. Drag to move."
              MouseLeftButtonDown="CardDown" MouseMove="CardMove" MouseLeftButtonUp="CardUp" KeyDown="CardKey">
        <Border.Style><Style TargetType="Border">
          <Setter Property="Background" Value="#1F242E"/><Setter Property="BorderBrush" Value="#2C3341"/>
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#262C39"/><Setter Property="BorderBrush" Value="#4D4968"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#A594EA"/></Trigger>
          </Style.Triggers>
        </Style></Border.Style>
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="21"/>
          <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="#96A1B7" TextWrapping="Wrap" LineHeight="19" MaxHeight="76" TextTrimming="CharacterEllipsis" Margin="0,8,0,0">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Body}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <DockPanel Margin="0,16,0,0">
            <TextBlock Text="{Binding Footer}" FontSize="10" Foreground="#8591A9" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <Border HorizontalAlignment="Left" CornerRadius="4" Padding="7,3" Background="#2D2B42">
              <TextBlock Text="{Binding Eyebrow}" FontSize="9" FontWeight="SemiBold">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#B8A8E9"/><Style.Triggers>
                  <DataTrigger Binding="{Binding Priority}" Value="High"><Setter Property="Foreground" Value="#E5B29B"/></DataTrigger>
                  <DataTrigger Binding="{Binding Priority}" Value="Low"><Setter Property="Foreground" Value="#9FB6D9"/></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Border>
          </DockPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Border BorderBrush="#2A2F3B" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#15181F" BorderBrush="#242A35" BorderThickness="0,0,0,1">
        <DockPanel Margin="16,0,6,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="—" Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="MinimizeClick"/>
            <Button Content="□" Style="{StaticResource CaptionButton}" ToolTip="Maximize or restore" Click="MaximizeClick"/>
            <Button Content="×" FontSize="19" Style="{StaticResource CaptionButton}" ToolTip="Close" Click="CloseClick"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Zentro;component/Assets/Zentro.png" Width="18" Height="18" Margin="0,0,9,0"/><TextBlock Text="Zentro" FontSize="12" Foreground="#AAB3C6"/></StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#15181F" BorderBrush="#242A35" BorderThickness="0,0,1,0">
          <DockPanel Margin="18,25,18,20">
            <StackPanel DockPanel.Dock="Top">
              <StackPanel Orientation="Horizontal" Margin="8,0,0,30"><Image Source="/Zentro;component/Assets/Zentro.png" Width="28" Height="28" Margin="0,0,10,0"/><TextBlock Text="Zentro" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
              <TextBlock Text="WORKSPACE" Foreground="#727F98" FontSize="9" FontWeight="SemiBold" Margin="13,0,0,12"/>
              <Button Click="BoardClick"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsNotes}" Value="False"><Setter Property="Background" Value="#2B273F"/><Setter Property="Foreground" Value="#C7B8FC"/></DataTrigger></Style.Triggers></Style></Button.Style>
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="Task board"/></StackPanel>
              </Button>
              <Button Click="NotesClick"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsNotes}" Value="True"><Setter Property="Background" Value="#2B273F"/><Setter Property="Foreground" Value="#C7B8FC"/></DataTrigger></Style.Triggers></Style></Button.Style>
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="Notes"/></StackPanel>
              </Button>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
              <Border BorderBrush="#2B303C" BorderThickness="0,1,0,0" Padding="8,17,0,0"><StackPanel><TextBlock Text="PERSONAL" Foreground="#8793AA" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding SaveStatus}" Foreground="#829A91" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
            </StackPanel><Grid/>
          </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="32,28,32,18">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel><TextBlock Text="Workspace  /  Personal" Foreground="#77839C" FontSize="11"/><TextBlock Text="{Binding DateLabel}" Foreground="#77839C" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
          <Grid Grid.Row="1" Margin="0,24,0,26">
            <StackPanel><TextBlock Text="{Binding Heading}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
            <Button Content="{Binding AddLabel}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="NewClick" IsEnabled="{Binding CanWrite}"/>
          </Grid>
          <Grid Grid.Row="2" Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid>
              <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="35,9,30,9" AutomationProperties.Name="Search tasks and notes"/>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#78849B" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"/>
              <TextBlock Text="{Binding SearchHint}" Foreground="#758198" IsHitTestVisible="False" Margin="36,0,30,0" VerticalAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <Button Content="×" Background="Transparent" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Click="ClearSearch" ToolTip="Clear search"/>
            </Grid>
            <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <Grid Grid.Row="3">
            <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsNotes}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <local:BoardColumn ColumnTitle="To do" Items="{Binding Todo}" Tone="#8390A8" CardTemplate="{StaticResource Card}" Margin="0,0,7,0" AllowDrop="True" AddRequested="NewColumn" DragOver="ColumnOver" DragLeave="ColumnLeave" Drop="ColumnDrop"/>
            <local:BoardColumn Grid.Column="1" ColumnTitle="Doing" Items="{Binding Doing}" Tone="#A58DE7" CardTemplate="{StaticResource Card}" Margin="7,0,7,0" AllowDrop="True" AddRequested="NewColumn" DragOver="ColumnOver" DragLeave="ColumnLeave" Drop="ColumnDrop"/>
            <local:BoardColumn Grid.Column="2" ColumnTitle="Done" Items="{Binding Done}" Tone="#74B99D" CardTemplate="{StaticResource Card}" Margin="7,0,0,0" AllowDrop="True" AddRequested="NewColumn" DragOver="ColumnOver" DragLeave="ColumnLeave" Drop="ColumnDrop"/>
          </Grid>
          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsNotes, Converter={StaticResource VisibleWhenTrue}}">
            <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource Card}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Width" Value="278"/><Setter Property="Margin" Value="0,0,15,0"/></Style></ItemsControl.ItemContainerStyle>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Empty, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock Text="{Binding EmptyTitle}" FontSize="18" Foreground="#BCC6DC" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding EmptyBody}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,9,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <DockPanel Margin="0,0,0,10" Visibility="{Binding HasNotice, Converter={StaticResource VisibleWhenTrue}}">
              <Button DockPanel.Dock="Right" Content="Undo" Click="UndoClick" Padding="10,3" Visibility="{Binding CanUndo, Converter={StaticResource VisibleWhenTrue}}"/>
              <TextBlock Text="{Binding Notice}" Foreground="#A6B0C8" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <DockPanel><TextBlock Text="Drag cards to move them between columns" Foreground="#6F7B93" FontSize="10"/><TextBlock Text="Ctrl+N  New     Ctrl+F  Search" Foreground="#6F7B93" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
