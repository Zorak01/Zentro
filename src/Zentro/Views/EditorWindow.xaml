<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Zentro.Views.EditorWindow" Style="{StaticResource {x:Type Window}}" Width="560" Height="660" MinHeight="580" MinWidth="500" WindowStartupLocation="CenterOwner" Icon="/Zentro;component/Assets/Zentro.ico" ShowInTaskbar="False" WindowStyle="None">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="70" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></WindowChrome.WindowChrome>
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <DockPanel><Button Content="×" IsCancel="True" DockPanel.Dock="Right" Padding="8,2" Background="Transparent" FontSize="20" WindowChrome.IsHitTestVisibleInChrome="True"/><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold"/></DockPanel>
      <TextBlock Text="Keep it simple. Make it actionable." Style="{StaticResource Muted}" Margin="0,7,0,22"/>
    </StackPanel>
    <StackPanel Grid.Row="1">
      <Label Content="_Title" Target="{Binding ElementName=TitleBox}" Foreground="#AAB3CD" Padding="0,0,0,7"/>
      <TextBox x:Name="TitleBox" MaxLength="200" Margin="0,0,0,16"/>
    </StackPanel>
    <DockPanel Grid.Row="2">
      <Label x:Name="BodyLabel" Content="_Details" Target="{Binding ElementName=BodyBox}" Foreground="#AAB3CD" Padding="0,0,0,7" DockPanel.Dock="Top"/>
      <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
    </DockPanel>
    <StackPanel Grid.Row="3" Margin="0,16,0,14">
      <StackPanel x:Name="TaskOptions" Orientation="Horizontal">
        <StackPanel Margin="0,0,14,0">
          <Label Content="_Status" Target="{Binding ElementName=StatusBox}" Foreground="#AAB3CD" Padding="0,0,0,7"/>
          <ComboBox x:Name="StatusBox"/>
        </StackPanel>
        <StackPanel>
          <Label Content="_Priority" Target="{Binding ElementName=PriorityBox}" Foreground="#AAB3CD" Padding="0,0,0,7"/>
          <ComboBox x:Name="PriorityBox"/>
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="ErrorText" Foreground="#FFBDAA" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>
    <DockPanel Grid.Row="4">
      <Button x:Name="DeleteButton" Content="Delete" Foreground="#FFBDAA" Background="Transparent" Click="DeleteClick" DockPanel.Dock="Left"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/>
        <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" Click="SaveClick"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
